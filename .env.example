POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spi-brains-api-db
DATABASE_URL=postgresql://postgres:postgres@db:5432/spi-brains-api-db

# Shared secret the host-side implementation runner presents (X-Runner-Token)
# to claim runs and patch status. Leave empty to disable the runner endpoints.
RUNNER_TOKEN=

# Slack notifier (proactive platform fase 3). Both empty = disabled (no-op).
# SLACK_BOT_TOKEN: Bot User OAuth Token (xoxb-...), scopes chat:write + im:write.
# SLACK_USER_ID: your Slack member ID (U0...), the DM recipient / fallback.
SLACK_BOT_TOKEN=
SLACK_USER_ID=
# App-level token (xapp-…, scope connections:write) for Socket Mode — enables the
# interactive Approve/Discard buttons on approval messages. Empty = buttons off.
SLACK_APP_TOKEN=
# Per-category channel routing (fase 3.1). Each is a Slack channel id (C0...)
# the bot was invited to; leave empty to fall back to the DM above.
SLACK_CHANNEL_APPROVALS=
SLACK_CHANNEL_CODE_REVIEW=
SLACK_CHANNEL_FAILURES=
SLACK_CHANNEL_DIGEST=
# Base URL of the web UI, for deep links inside Slack messages.
WEB_BASE_URL=http://localhost:3737
